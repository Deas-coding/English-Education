  margin-bottom:18px;
  background:linear-gradient(135deg,var(--accent-light),var(--paper));
  border:1px dashed var(--accent);
  min-height:230px;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  cursor:pointer;
  transition:.35s;
}
.upload-card:hover{
  transform:translateY(-6px);
  box-shadow:var(--shadow);
}
.upload-card .plus-circle{
  width:65px;height:65px;border-radius:50%;
  background:var(--dark);color:white;
  display:flex;align-items:center;justify-content:center;
  font-size:30px;margin:auto auto 14px;
  transition:.3s;
}
.upload-card:hover .plus-circle{
  background:var(--accent);
  transform:rotate(90deg) scale(1.08);
}
.upload-card strong{display:block;font-size:14px;margin-bottom:5px}
.upload-card span{font-size:11px;color:var(--muted)}

.card-actions{
  display:flex;
  gap:6px;
  margin-top:10px;
}
.card-edit{
  border:1px solid var(--line);
  background:#faf8f2;
  color:var(--muted);
  border-radius:50px;
  padding:6px 10px;
  cursor:pointer;
  font-size:10px;
  transition:.25s;
}
.card-edit:hover{
  background:var(--dark);
  color:white;
  border-color:var(--dark);
}

.secure-modal{
  position:fixed;
  inset:0;
  background:rgba(20,20,18,.72);
  z-index:1200;
  display:none;
  align-items:center;
  justify-content:center;
  padding:20px;
  backdrop-filter:blur(10px);
}
.secure-modal.show{display:flex}
.secure-box{
  width:min(500px,100%);
  background:var(--paper);
  border:1px solid rgba(255,255,255,.7);
  box-shadow:var(--shadow-heavy);
  padding:30px;
  position:relative;
}
.secure-kicker{
  text-transform:uppercase;
  letter-spacing:.18em;
  color:var(--muted);
  font-size:9px;
  margin-bottom:9px;
}
.secure-box h3{
  font-family:'Playfair Display',serif;
  font-size:32px;
  line-height:1;
  margin-bottom:9px;
}
.secure-box p{
  color:var(--muted);
  font-size:12px;
  line-height:1.65;
  margin-bottom:20px;
}
.secure-form{
  display:flex;
  flex-direction:column;
  gap:10px;
}
.secure-form input,
.secure-form textarea,
.secure-form select{
  width:100%;
  border:1px solid var(--line);
  background:#faf8f2;
  padding:12px 13px;
  outline:none;
  border-radius:3px;
  color:var(--text);
}
.secure-form input:focus,
.secure-form textarea:focus,
.secure-form select:focus{
  border-color:var(--accent);
}
.secure-form textarea{min-height:105px;resize:vertical}
.secure-actions{
  display:flex;
  gap:8px;
  justify-content:flex-end;
  margin-top:4px;
}
.secure-primary,
.secure-secondary{
  border:0;
  border-radius:100px;
  padding:11px 16px;
  cursor:pointer;
  font-size:11px;
}
.secure-primary{background:var(--dark);color:white}
.secure-primary:hover{background:var(--accent)}
.secure-secondary{background:#ece9e1;color:var(--text)}
.secure-close{
  position:absolute;
  right:14px;
  top:14px;
  width:30px;height:30px;
  border:1px solid var(--line);
  background:var(--paper);
  border-radius:50%;
  cursor:pointer;
}
.upload-preview{
  width:100%;
  max-height:230px;
  object-fit:cover;
  margin-bottom:15px;
  display:none;
}
.upload-preview.show{display:block}
.secure-error{
  min-height:16px;
  color:#a14f45;
  font-size:10px;
}
.upload-success{
  position:fixed;
  left:50%;
  bottom:28px;
  transform:translate(-50%,20px);
  opacity:0;
  pointer-events:none;
  z-index:1300;
  background:var(--dark);
  color:white;
  padding:11px 16px;
  border-radius:100px;
  font-size:11px;
  transition:.3s;
}
.upload-success.show{
  opacity:1;
  transform:translate(-50%,0);
}

