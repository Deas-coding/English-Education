});



/* =========================================================
   IMAGE MODAL
========================================================= */

const modal =
  document.getElementById('modal');

const modalImg =
  document.getElementById('modalImg');

const modalCaption =
  document.getElementById('modalCaption');

const close =
  document.getElementById('close');


function activateCard(card){

  card.addEventListener('click', () => {

    const img =
      card.querySelector('img');


    modalImg.src =
      img.src;


    modalImg.alt =
      img.alt;


    modalCaption.textContent =
      card.dataset.title +
      ' — ' +
      card.dataset.caption;


    modal.classList.add('show');

  });

}


refreshCards().forEach(
  activateCard
);


/*
  Foto bawaan juga bisa diedit title/caption,
  tetapi tetap harus melewati kode khusus.
*/
refreshCards().forEach(card => {

  const info = card.querySelector('.card-info');
  if(!info) return;

  const textWrap = info.querySelector(':scope > div');
  if(!textWrap) return;

  const actions = document.createElement('div');
  actions.className = 'card-actions';

  const editButton = document.createElement('button');
  editButton.type = 'button';
  editButton.className = 'card-edit';
  editButton.textContent = 'Edit title & caption';

  editButton.addEventListener('click', event => {
    event.stopPropagation();
    requestEdit(card);
  });

  actions.appendChild(editButton);
  textWrap.appendChild(actions);

});


function closeModal(){

  modal.classList.remove('show');

}


close.addEventListener(
  'click',
  closeModal
);


modal.addEventListener(
  'click',
  e => {

    if(e.target === modal){

      closeModal();

    }

  }
);


document.addEventListener(
  'keydown',
  e => {

    if(e.key === 'Escape'){

      closeModal();

    }

  }
);



/* =========================================================
   SECURE + PERSISTENT CLASS CONTENT
========================================================= */

/* GANTI kode ini dengan kode rahasia kelasmu. */
const UPLOAD_ACCESS_CODE = 'GANTI_KODE_RAHASIA';

const openUpload = document.getElementById('openUpload');
const photoUpload = document.getElementById('photoUpload');
const codeModal = document.getElementById('codeModal');
const codeForm = document.getElementById('codeForm');
const uploadCode = document.getElementById('uploadCode');
const codeError = document.getElementById('codeError');
const photoDetailsModal = document.getElementById('photoDetailsModal');
const photoDetailsForm = document.getElementById('photoDetailsForm');
const uploadPreview = document.getElementById('uploadPreview');
const photoTitle = document.getElementById('photoTitle');
const photoCaption = document.getElementById('photoCaption');
const photoChapter = document.getElementById('photoChapter');
const photoDetailsHeading = document.getElementById('photoDetailsHeading');
const savePhotoDetails = document.getElementById('savePhotoDetails');
const uploadToast = document.getElementById('uploadToast');

const openMemberUpload = document.getElementById('openMemberUpload');
const memberDetailsModal = document.getElementById('memberDetailsModal');
const memberDetailsForm = document.getElementById('memberDetailsForm');
const memberPhotoInput = document.getElementById('memberPhotoInput');
const memberPreview = document.getElementById('memberPreview');
const memberNameInput = document.getElementById('memberNameInput');
const memberRoleInput = document.getElementById('memberRoleInput');
const memberGrid = document.getElementById('memberGrid');

let pendingFile = null;
let editingCard = null;
let pendingMemberFile = null;
let authenticated = false;
let secureAction = '';
let db;

/* IndexedDB membuat foto/anggota tetap ada setelah refresh dan browser ditutup. */
const DB_NAME = 'EnglishEducationArchiveDB';
const DB_VERSION = 1;

function openDatabase(){
  return new Promise((resolve,reject)=>{
    const request = indexedDB.open(DB_NAME, DB_VERSION);
    request.onupgradeneeded = event => {
      const database = event.target.result;
      if(!database.objectStoreNames.contains('photos')){
        database.createObjectStore('photos', {keyPath:'id'});
      }
      if(!database.objectStoreNames.contains('members')){
        database.createObjectStore('members', {keyPath:'id'});
      }
    };
    request.onsuccess = event => { db = event.target.result; resolve(db); };
    request.onerror = () => reject(request.error);
  });
}

function idbPut(store, value){
  return new Promise((resolve,reject)=>{
    const tx = db.transaction(store,'readwrite');
    tx.objectStore(store).put(value);
    tx.oncomplete = resolve;
    tx.onerror = () => reject(tx.error);
  });
}

function idbDelete(store, id){
  return new Promise((resolve,reject)=>{
    const tx = db.transaction(store,'readwrite');
    tx.objectStore(store).delete(id);
    tx.oncomplete = resolve;
    tx.onerror = () => reject(tx.error);
  });
}

function idbGetAll(store){
  return new Promise((resolve,reject)=>{
    const tx = db.transaction(store,'readonly');
    const request = tx.objectStore(store).getAll();
    request.onsuccess = () => resolve(request.result || []);
    request.onerror = () => reject(request.error);
  });
}

function openCodeModal(action){
  secureAction = action;
  codeError.textContent = '';
  uploadCode.value = '';
  codeModal.classList.add('show');
  setTimeout(()=>uploadCode.focus(),80);
}

function closeSecureModal(id){
  document.getElementById(id).classList.remove('show');
}

document.querySelectorAll('[data-close-secure]').forEach(button=>{
  button.addEventListener('click',()=>closeSecureModal(button.dataset.closeSecure));
});

openUpload.addEventListener('click',()=>{
  authenticated = false;
  editingCard = null;
  pendingFile = null;
  openCodeModal('add-photo');
});

openMemberUpload.addEventListener('click',()=>{
  authenticated = false;
  openCodeModal('add-member');
});

codeForm.addEventListener('submit',event=>{
  event.preventDefault();
  const enteredCode = uploadCode.value.trim();

  if(enteredCode !== UPLOAD_ACCESS_CODE || !enteredCode){
    codeError.textContent = 'Kode salah. Silakan coba lagi.';
    uploadCode.select();
    return;
  }

  authenticated = true;
  codeError.textContent = '';
  codeModal.classList.remove('show');

  if(secureAction === 'add-photo'){
    photoUpload.click();
  }else if(secureAction === 'add-member'){
    memberDetailsForm.reset();
    memberRoleInput.value = 'Classmate';
    memberPreview.classList.remove('show');
    pendingMemberFile = null;
    memberDetailsModal.classList.add('show');
  }else if(secureAction === 'edit-photo'){
    preparePhotoEdit();
  }else if(secureAction === 'delete-photo'){
    deletePhotoAfterCode();
  }else if(secureAction === 'delete-member'){
    deleteMemberAfterCode();
  }
});

photoUpload.addEventListener('change',function(){
  if(!authenticated){ this.value=''; return; }
  const file = this.files[0];
  if(!file) return;
  if(!file.type.startsWith('image/')){
    showUploadToast('File harus berupa gambar.');
    this.value='';
    return;
  }

  pendingFile = file;
  editingCard = null;
  uploadPreview.src = URL.createObjectURL(file);
  uploadPreview.classList.add('show');
  photoDetailsHeading.textContent = 'Atur detail foto.';
  savePhotoDetails.textContent = 'Tambahkan foto →';
  photoTitle.value = file.name.replace(/\.[^/.]+$/,'').slice(0,80);
  photoCaption.value = 'Kenangan yang baru ditambahkan.';
  photoChapter.value = 'event';
  photoDetailsModal.classList.add('show');
  setTimeout(()=>{photoTitle.focus();photoTitle.select();},80);
  this.value='';
});

photoDetailsForm.addEventListener('submit',async event=>{
  event.preventDefault();
  if(!authenticated) return;

  const title = photoTitle.value.trim();
  const caption = photoCaption.value.trim();
  const chapter = photoChapter.value;
  if(!title || !caption) return;

  try{
    if(editingCard){
      const id = editingCard.dataset.localId;
      if(id){
        const photos = await idbGetAll('photos');
        const saved = photos.find(p=>p.id === id);
        if(saved){
          saved.title = title;
          saved.caption = caption;
          saved.chapter = chapter;
          await idbPut('photos',saved);
        }
      }

      editingCard.dataset.title = title;
      editingCard.dataset.caption = caption;
      editingCard.dataset.year = chapter;
      editingCard.querySelector('.card-title').textContent = title;
      editingCard.querySelector('.card-caption').textContent = caption;
      editingCard.querySelector('.card-date').textContent = chapter==='event'?'EVENT':chapter;
      editingCard.querySelector('img').alt = title;

      closeSecureModal('photoDetailsModal');
      showUploadToast('Detail foto berhasil disimpan.');
      editingCard = null;
      authenticated = false;
      return;
    }

    if(!pendingFile) return;
    const dataUrl = await fileToDataURL(pendingFile);
    const id = 'photo_' + Date.now() + '_' + Math.random().toString(36).slice(2,8);

    await idbPut('photos',{id,title,caption,chapter,dataUrl,createdAt:Date.now()});
    renderSavedPhoto({id,title,caption,chapter,dataUrl});

    closeSecureModal('photoDetailsModal');
    showUploadToast('Foto berhasil disimpan di web ini.');
    pendingFile = null;
    authenticated = false;
  }catch(error){
    console.error(error);
    showUploadToast('Gagal menyimpan. Coba lagi.');
  }
});

function fileToDataURL(file){
  return new Promise((resolve,reject)=>{
    const reader = new FileReader();
    reader.onload = ()=>resolve(reader.result);
    reader.onerror = ()=>reject(reader.error);
    reader.readAsDataURL(file);
  });
}

function addCardActions(card){
  if(card.querySelector('.card-actions')) return;
  const info = card.querySelector('.card-info');
  if(!info) return;
  const textWrap = info.querySelector(':scope > div');
  if(!textWrap) return;

  const actions = document.createElement('div');
  actions.className = 'card-actions';

  const editButton = document.createElement('button');
  editButton.type='button';
  editButton.className='card-edit';
  editButton.textContent='Edit';
  editButton.addEventListener('click',event=>{
    event.stopPropagation();
    requestEdit(card);
  });

  const deleteButton = document.createElement('button');
  deleteButton.type='button';
  deleteButton.className='card-delete';
  deleteButton.textContent='Hapus';
  deleteButton.addEventListener('click',event=>{
    event.stopPropagation();
    requestDeletePhoto(card);
  });

  actions.append(editButton,deleteButton);
  textWrap.appendChild(actions);
}

function renderSavedPhoto(photo){
  const article = document.createElement('article');
  article.className='card';
  article.dataset.year=photo.chapter;
  article.dataset.title=photo.title;
  article.dataset.caption=photo.caption;
  article.dataset.localId=photo.id;
  article.innerHTML='';

  const img=document.createElement('img');
  img.src=photo.dataUrl;
  img.alt=photo.title;

  const info=document.createElement('div');
  info.className='card-info';
  const textWrap=document.createElement('div');
  const titleEl=document.createElement('div');
  titleEl.className='card-title';
  titleEl.textContent=photo.title;
  const captionEl=document.createElement('div');
  captionEl.className='card-caption';
  captionEl.textContent=photo.caption;
  const date=document.createElement('span');
  date.className='card-date';
  date.textContent=photo.chapter==='event'?'EVENT':photo.chapter;

  textWrap.append(titleEl,captionEl);
  info.append(textWrap,date);
  article.append(img,info);
  gallery.appendChild(article);
  addCardActions(article);
  activateCard(article);
}

function requestEdit(card){
  editingCard=card;
  pendingFile=null;
  authenticated=false;
  openCodeModal('edit-photo');
}

function preparePhotoEdit(){
  if(!editingCard) return;
  photoDetailsHeading.textContent='Edit detail foto.';
  savePhotoDetails.textContent='Simpan perubahan';
  photoTitle.value=editingCard.dataset.title || '';
  photoCaption.value=editingCard.dataset.caption || '';
  photoChapter.value=editingCard.dataset.year || 'event';
  const existingImg=editingCard.querySelector('img');
  uploadPreview.src=existingImg.src;
  uploadPreview.classList.add('show');
  photoDetailsModal.classList.add('show');
  setTimeout(()=>{photoTitle.focus();photoTitle.select();},80);
}

function requestDeletePhoto(card){
  editingCard=card;
  authenticated=false;
  openCodeModal('delete-photo');
}

async function deletePhotoAfterCode(){
  if(!editingCard) return;
  const id=editingCard.dataset.localId;
  if(!id){
    showUploadToast('Foto bawaan website tidak dapat dihapus dari penyimpanan lokal.');
    editingCard=null;
    authenticated=false;
    return;
  }
  if(!confirm('Hapus foto ini dari galeri?')) return;
  await idbDelete('photos',id);
  editingCard.remove();
  editingCard=null;
  authenticated=false;
  showUploadToast('Foto berhasil dihapus.');
}

/* ---------------- MEMBERS ---------------- */

function addMemberActions(card,id){
  if(card.querySelector('.member-delete-wrap')) return;
  const wrap=document.createElement('div');
  wrap.className='member-delete-wrap';
  const button=document.createElement('button');
  button.type='button';
  button.className='member-delete';
  button.textContent='Hapus';
  button.addEventListener('click',event=>{
    event.stopPropagation();
    requestDeleteMember(card,id);
  });
  wrap.appendChild(button);
  card.appendChild(wrap);
}

function renderSavedMember(member){
  const card=document.createElement('div');
  card.className='member';
  card.dataset.localId=member.id;

  const photo=document.createElement('div');
  photo.className='member-photo';
  const img=document.createElement('img');
  img.src=member.dataUrl;
  img.alt=member.name;
  photo.appendChild(img);

  const info=document.createElement('div');
  info.className='member-info';
  const name=document.createElement('div');
  name.className='member-name';
  name.textContent=member.name;
  const role=document.createElement('div');
  role.className='member-role';
  role.textContent=member.role;
  info.append(name,role);
  card.append(photo,info);
  memberGrid.appendChild(card);
  addMemberActions(card,member.id);
}

memberPhotoInput.addEventListener('change',()=>{
  const file=memberPhotoInput.files[0];
  pendingMemberFile=file || null;
  if(file){
    memberPreview.src=URL.createObjectURL(file);
    memberPreview.classList.add('show');
  }
});

memberDetailsForm.addEventListener('submit',async event=>{
  event.preventDefault();
  if(!authenticated || !pendingMemberFile) return;

  const name=memberNameInput.value.trim();
  const role=memberRoleInput.value.trim();
  if(!name || !role) return;

  try{
    const dataUrl=await fileToDataURL(pendingMemberFile);
    const id='member_'+Date.now()+'_'+Math.random().toString(36).slice(2,8);
    const member={id,name,role,dataUrl,createdAt:Date.now()};
    await idbPut('members',member);
    renderSavedMember(member);
    closeSecureModal('memberDetailsModal');
    showUploadToast('Anggota berhasil ditambahkan.');
    pendingMemberFile=null;
    authenticated=false;
  }catch(error){
    console.error(error);
    showUploadToast('Gagal menyimpan anggota.');
  }
});

let memberToDelete=null;
function requestDeleteMember(card,id){
  memberToDelete={card,id};
  authenticated=false;
  openCodeModal('delete-member');
}

async function deleteMemberAfterCode(){
  if(!memberToDelete) return;
  if(!confirm('Hapus anggota ini dari daftar kelas?')) return;
  await idbDelete('members',memberToDelete.id);
  memberToDelete.card.remove();
  memberToDelete=null;
  authenticated=false;
  showUploadToast('Anggota berhasil dihapus.');
}

function showUploadToast(message){
  uploadToast.textContent=message;
  uploadToast.classList.add('show');
  setTimeout(()=>uploadToast.classList.remove('show'),2500);
}

async function loadPersistentContent(){
  try{
    await openDatabase();
    const photos=await idbGetAll('photos');
    photos.sort((a,b)=>(a.createdAt||0)-(b.createdAt||0));
    photos.forEach(renderSavedPhoto);

    const members=await idbGetAll('members');
    members.sort((a,b)=>(a.createdAt||0)-(b.createdAt||0));
    members.forEach(renderSavedMember);

    refreshCards().forEach(addCardActions);
  }catch(error){
    console.error('IndexedDB:',error);
    showUploadToast('Penyimpanan browser tidak tersedia.');
  }
}

/* Kartu bawaan tetap bisa diedit, tetapi edit/hapus selalu minta kode. */
refreshCards().forEach(addCardActions);
loadPersistentContent();


/* =========================================================
   LIVE CLOCK
========================================================= */

const liveTime =
  document.getElementById('liveTime');

const liveDate =
  document.getElementById('liveDate');


function updateClock(){

  const now =
    new Date();


  const time =
    now.toLocaleTimeString(
      'id-ID',
      {
        hour:'2-digit',
        minute:'2-digit',
        second:'2-digit',
        hour12:false
      }
    );


  const date =
    now.toLocaleDateString(
      'id-ID',
      {
        weekday:'long',
        day:'numeric',
        month:'long',
        year:'numeric'
      }
    );


  liveTime.textContent =
    time;


  liveDate.textContent =
    date;

}


updateClock();


setInterval(
  updateClock,
  1000
);



/* =========================================================
   MUSIC PLAYER
========================================================= */

const music =
  document.getElementById('bgMusic');

const musicBtn =
  document.getElementById('musicBtn');

const musicIcon =
  document.getElementById('musicIcon');

const musicStatus =
  document.getElementById('musicStatus');


musicBtn.addEventListener(
  'click',
  () => {

    if(music.paused){

      music.play()

        .then(() => {

          musicIcon.textContent =
            'Ⅱ';

          musicStatus.textContent =
            'MUSIC ON';

          musicBtn.classList.add(
            'playing'
          );

        })

        .catch(error => {

          console.log(
            'Musik gagal diputar:',
            error
          );

        });

    }

    else{

      music.pause();


      musicIcon.textContent =
        '▶';


      musicStatus.textContent =
        'MUSIC OFF';


      musicBtn.classList.remove(
        'playing'
      );

    }

  }
);


music.addEventListener(
  'ended',
  () => {

    musicIcon.textContent =
      '▶';


    musicStatus.textContent =
      'MUSIC OFF';


    musicBtn.classList.remove(
      'playing'
    );

  }
);



/* =========================================================
   SCROLL REVEAL
========================================================= */

const revealElements =
  document.querySelectorAll(
    '.reveal'
  );


const revealObserver =
  new IntersectionObserver(
    entries => {

      entries.forEach(
        entry => {

          if(entry.isIntersecting){

            entry.target.classList.add(
              'visible'
            );

          }

        }
      );

    },
    {
      threshold:.12
    }
  );


revealElements.forEach(
  element =>
    revealObserver.observe(element)
);

</script>

